# Database - Supabase PostgreSQL
# Pooled connection (para la app en runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (para migraciones de Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# JWT Secret (SOLO proyectos legacy con firma HS256; Dashboard → Settings → API → JWT Secret).
# Los proyectos con signing keys nuevas (ES256/RS256) NO lo necesitan: el token se
# valida contra el JWKS público del proyecto. Si un proyecto HS256 no lo define,
# el guard cae al fallback remoto (auth.getUser) y loguea un warning.
# SUPABASE_JWT_SECRET="your-jwt-secret"

# ePayco
EPAYCO_PUBLIC_KEY="your-epayco-public-key"
EPAYCO_PRIVATE_KEY="your-epayco-private-key"
EPAYCO_P_CUST_ID="your-epayco-p-cust-id"
EPAYCO_P_KEY="your-epayco-p-key"
EPAYCO_TEST="true"

# AI Provider: "anthropic" | "gemini"
AI_PROVIDER="anthropic"
# Limite de salida para el analisis narrativo del estudio
AI_MAX_TOKENS=1024
# Limite de salida para la extraccion de PDF (datos + red flags de fiabilidad)
AI_MAX_TOKENS_EXTRACTION=8000
# Modelo especifico para extraccion de PDF (opcional; si se omite usa el modelo
# por defecto del provider). Util para usar un modelo mas capaz en aritmetica
# solo en la extraccion. Ej: gemini-2.5-pro
# AI_EXTRACTION_MODEL="gemini-2.5-pro"

# Anthropic (Claude AI) — required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Google Gemini — required if AI_PROVIDER=gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# App
PORT=3000
# Entorno de la aplicacion (staging | production). Habilita los endpoints
# exclusivos de staging (p. ej. la purga de empresas, que responde 404 fuera de
# alli). Si no se define, cae a SENTRY_ENV; sin ninguna de las dos NO es staging.
APP_ENV="staging"
# Swagger (/docs). Por defecto: encendido salvo NODE_ENV=production. Este flag
# fuerza el estado en cualquier entorno: true para exponerlo (p. ej. staging
# desplegado), false para apagarlo siempre.
# SWAGGER_ENABLED="true"

# Correo (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
# URL base del front del CLIENTE (donde el invitado abre el link /invitacion).
# En staging/prod debe apuntar al dominio real desplegado, no a localhost.
FRONTEND_URL="http://localhost:4200"
# URL publica del logo de Creditia usado en los correos (debe ser PNG y absoluta;
# los clientes de correo no renderizan SVG de forma confiable)
LOGO_URL="https://bjawxcnsjjobweucxfpf.supabase.co/storage/v1/object/public/general/creditia-logo.png"

# Firma electronica (Zapsign)
# Base de la API. Opcional: por defecto https://api.zapsign.com.br/api/v1
# ZAPSIGN_API_URL="https://api.zapsign.com.br/api/v1"
# Flag POR DOCUMENTO, no un entorno aparte. true = documentos de PRUEBA (no
# gastan cuota ni tienen validez legal). En staging va en true; en PRODUCCION
# debe ir en false o los documentos reales quedan marcados como prueba.
ZAPSIGN_SANDBOX="true"
ZAPSIGN_API_TOKEN="your-zapsign-api-token"

# Modelos (plantillas dinamicas) subidos a Zapsign. El id cambia si se sube un
# modelo nuevo en vez de editar el existente.
ZAPSIGN_CUSTOMER_AUTH_TEMPLATE_ID_PN=""
ZAPSIGN_CUSTOMER_AUTH_TEMPLATE_ID_PJ=""
ZAPSIGN_PROMISSORY_NOTE_TEMPLATE_ID=""

# Anclas de posicionamiento de firma: texto `<<...>>` presente en el modelo
# donde Zapsign estampa la firma. Si el ancla aparece VARIAS veces, la firma se
# estampa en TODAS las ocurrencias (es lo que pone la firma del deudor tanto en
# el pagare como en la autorizacion de espacios en blanco). Zapsign NO borra el
# texto del ancla: en el modelo va en color blanco. Vacio = firma solo al final.
ZAPSIGN_PROMISSORY_NOTE_SIGNATURE_ANCHOR="<<FIRMA_DEUDOR>>"

# Sentry (registro de errores). Si SENTRY_DSN esta vacio, el SDK no se inicializa
# y no se reporta nada (util en local).
SENTRY_DSN="https://xxxxxxxx@oXXXXXX.ingest.us.sentry.io/XXXXXX"
# Entorno reportado a Sentry (development | staging | production)
SENTRY_ENV="development"
# Muestreo de performance/tracing: 0 = solo errores; 0.1 = 10% de transacciones
SENTRY_TRACES_SAMPLE_RATE=0

# Buzon central de soporte/ventas: SIEMPRE recibe copia de los correos internos
# (tickets de soporte, contacto comercial, alertas de pago). Default soporte@creditia.co
SUPPORT_EMAIL=soporte@creditia.co

# DataCredito Experian (MiDecisor)
# client_id y client_secret son COMPARTIDOS entre persona natural (PN) y juridica
# (PJ). Lo unico que cambia es el usuario (EXPERIAN_USERNAME_PN / _PJ).
# La contrasena hoy es la misma para ambos (EXPERIAN_PASSWORD); si a futuro se
# separan, usar EXPERIAN_PASSWORD_PN / EXPERIAN_PASSWORD_PJ (con fallback a la generica).
# NIT (tipoIdentificacion '2') se resuelve como PJ; el resto (CC, CE, PAS...) como PN.
EXPERIAN_BASE_URL=""
EXPERIAN_CLIENT_ID=""
EXPERIAN_CLIENT_SECRET=""
EXPERIAN_USERNAME_PN=""
EXPERIAN_USERNAME_PJ=""
EXPERIAN_PASSWORD=""

# Facturacion electronica
# Cual adaptador se inyecta. Hoy solo 'aliaddo'.
EINVOICE_PROVIDER="aliaddo"
# Kill switch: en false la factura queda REGISTRADA como pendiente y no se envia.
EINVOICE_ENABLED="false"
# Ambiente DECLARADO (test | habilitation | production). No tiene default: un
# valor desconocido revienta al arrancar.
# OJO: con la API contable esto NO viaja en el payload. El ambiente real lo
# determina la CUENTA de Aliaddo a la que pertenece el token: un token de
# produccion factura en produccion diga lo que diga esta etiqueta. Sirve para
# archivarlo con el documento y para las advertencias del panel.
EINVOICE_ENVIRONMENT="test"
# Cuenta contable (bancos/caja) donde entra el recaudo de ePayco. Con ella la
# factura nace PAGADA; sin ella queda como cartera abierta en la contabilidad del
# facturador, aunque el cliente ya haya pagado. Se consulta en
# GET /api/admin/einvoices/accounts.
EINVOICE_PAYMENT_ACCOUNT_CODE=""

# Adaptador Aliaddo (API "Software contable y administrativo")
ALIADDO_API_URL="https://nitro.aliaddo.net"
# Portal Nitro -> Integracion -> generar token. No expira, pero es revocable.
ALIADDO_TOKEN=""
# Sucursal de emision. Opcional: si se omite se usa la marcada por defecto entre
# las habilitadas (GET /api/admin/einvoices/branches).
ALIADDO_BRANCH_ID=""
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DaneRegion {
  code      String   @id @db.VarChar(2) // '11'
  name      String   @db.VarChar(150) // 'Bogotá'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities DaneCity[]

  @@map("dane_regions")
}

model DaneCity {
  code       String @id @db.VarChar(5) // '11001'
  regionCode String @map("region_code") @db.VarChar(2)
  name       String @db.VarChar(150)
  dianName   String @map("dian_name") @db.VarChar(150)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region DaneRegion @relation(fields: [regionCode], references: [code])

  companies        Company[]       @relation("CompanyCity")
  billingCompanies Company[]       @relation("CompanyBillingCity")
  customers        Customer[]      @relation("CustomerCity")
  platformAdmins   PlatformAdmin[] @relation("PlatformAdminCity")

  @@index([regionCode, name]) // desplegable de ciudades por departamento
  @@map("dane_cities")
}

// ─── Tabla maestra de parámetros (llave-valor) ─────────────

model Parameter {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  label       String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  parentId    Int?     @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Parameter?  @relation("ParameterHierarchy", fields: [parentId], references: [id])
  children Parameter[] @relation("ParameterHierarchy")

  companiesBySector                     Company[]             @relation("CompanySector")
  customersByType                       Customer[]            @relation("CustomerPersonType")
  customersByEconomicActivity           Customer[]            @relation("CustomerEconomicActivity")
  profilesByRole                        Profile[]             @relation("ProfileRole")
  profilesByIdentificationType          Profile[]             @relation("ProfileIdentificationType")
  userCompaniesByRole                   UserCompany[]         @relation("UserCompanyRole")
  creditStudiesByStatus                 CreditStudy[]         @relation("CreditStudyStatus")
  financialStatementsByIncomeStatement  FinancialStatementPeriod[] @relation("FinancialStatementIncomeStatement")
  aiAnalysesByType                      AiAnalysis[]          @relation("AiAnalysisType")
  invitationsByStatus                   Invitation[]          @relation("InvitationStatus")
  customersByIdentificationType         Customer[]            @relation("CustomerIdentificationType")
  customersByLegalRepIdentificationType Customer[]            @relation("CustomerLegalRepIdentificationType")
  companiesByLegalRepIdentificationType  Company[]            @relation("CompanyLegalRepIdentificationType")
  companiesByAccountType                Company[]             @relation("CompanyAccountType")
  companiesByAccountBank                Company[]             @relation("CompanyAccountBank")
  companiesByBillingDocType             Company[]             @relation("CompanyBillingDocType")
  companiesByBillingRegimeType          Company[]             @relation("CompanyBillingRegimeType")
  promissoryNotesByStatus               PromissoryNote[]      @relation("PromissoryNoteStatus")
  notificationsByType                   Notification[]        @relation("NotificationType")
  packOfferingsByDiscountType           PackOffering[]        @relation("PackOfferingDiscountType")
  analysisPacksByStatus                 AnalysisPack[]        @relation("AnalysisPackStatus")
  paymentAlertsByType                   PaymentAlert[]        @relation("PaymentAlertType")
  paymentAlertsBySeverity               PaymentAlert[]        @relation("PaymentAlertSeverity")
  paymentAlertsByStatus                 PaymentAlert[]        @relation("PaymentAlertStatus")
  promoCodesByScope                     PromoCode[]           @relation("PromoCodeScope")
  promoCodesByAppliesTo                 PromoCode[]           @relation("PromoCodeAppliesTo")
  contactRequestsBySubject              ContactRequest[]      @relation("ContactRequestSubject")
  contactRequestsByStatus               ContactRequest[]      @relation("ContactRequestStatus")
  platformAdminsByRole                  PlatformAdmin[]       @relation("PlatformAdminRole")
  platformAdminsByIdentificationType    PlatformAdmin[]       @relation("PlatformAdminIdentificationType")
  supportTicketsByArea                  SupportTicket[]       @relation("SupportTicketArea")
  supportTicketsByType                  SupportTicket[]       @relation("SupportTicketType")
  supportTicketsByPriority              SupportTicket[]       @relation("SupportTicketPriority")
  supportTicketsByStatus                SupportTicket[]       @relation("SupportTicketStatus")
  blogPostsByCategory                   BlogPost[]            @relation("BlogPostCategory")
  blogPostsByStatus                     BlogPost[]            @relation("BlogPostStatus")
  electronicInvoicesByStatus            ElectronicInvoice[]   @relation("ElectronicInvoiceStatus")
  scoringConfigurationsByPersonType     ScoringConfiguration[] @relation("ScoringConfigurationPersonType")
  customerAuthorizationsByStatus        CustomerAuthorization[] @relation("CustomerAuthorizationStatus")
  customerAuthorizationsByType          CustomerAuthorization[] @relation("CustomerAuthorizationType")
  customerAuthorizationsByIdentType     CustomerAuthorization[] @relation("CustomerAuthorizationIdentType")
  salesCommissionsByStatus              SalesCommission[]     @relation("SalesCommissionStatus")

  @@unique([type, code])
  @@map("parameters")
}

// ─── Profile (extiende auth.users de Supabase) ─────────────

model Profile {
  id                   String   @id @db.Uuid
  email                String   @unique @db.VarChar(255)
  name                 String?  @db.VarChar(150)
  lastName             String?  @map("last_name") @db.VarChar(150)
  phone                String?  @db.VarChar(50)
  roleId               Int?     @map("role_id")
  position             String?  @db.VarChar(150)
  identificationTypeId Int?     @map("identification_type_id")
  identificationNumber String?  @map("identification_number") @db.VarChar(50)
  metadata             Json?    @default("{}")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  role                      Parameter?          @relation("ProfileRole", fields: [roleId], references: [id])
  identificationType        Parameter?          @relation("ProfileIdentificationType", fields: [identificationTypeId], references: [id])
  userCompanies             UserCompany[]       @relation("UserCompanyUser")
  invitedUsers              UserCompany[]       @relation("UserCompanyInvitedBy")
  sentInvitations           Invitation[]        @relation("InvitationInvitedBy")
  createdCustomers          Customer[]          @relation("CustomerCreatedBy")
  updatedCustomers          Customer[]          @relation("CustomerUpdatedBy")
  createdStudies            CreditStudy[]       @relation("CreditStudyCreatedBy")
  updatedStudies            CreditStudy[]       @relation("CreditStudyUpdatedBy")
  aiAnalyses                AiAnalysis[]        @relation("AiAnalysisPerformedBy")
  createdPromissoryNotes    PromissoryNote[]    @relation("PromissoryNoteCreatedBy")
  createdNotifications      Notification[]      @relation("NotificationCreatedBy")
  notificationReads         NotificationRead[]  @relation("NotificationReadUser")
  analysisConsumptions      AnalysisConsumption[] @relation("AnalysisConsumptionConsumedBy")
  resolvedPaymentAlerts     PaymentAlert[]      @relation("PaymentAlertResolvedBy")
  promoRedemptions          PromoCodeRedemption[] @relation("PromoCodeRedemptionRedeemedBy")
  promoRedeemedPacks        AnalysisPack[]      @relation("AnalysisPackPromoRedeemedBy")
  createdSupportTickets     SupportTicket[]     @relation("SupportTicketCreatedBy")
  bureauConsultations       CreditBureauConsultation[] @relation("CreditBureauConsultationCreatedBy")
  createdFinancialStatements FinancialStatementPeriod[] @relation("FinancialStatementCreatedBy")
  createdFinancialAnalyses   FinancialAnalysis[]        @relation("FinancialAnalysisCreatedBy")
  createdScoringConfigurations ScoringConfiguration[]   @relation("ScoringConfigurationCreatedBy")
  createdCustomerAuthorizations CustomerAuthorization[] @relation("CustomerAuthorizationCreatedBy")
  revokedCustomerAuthorizations CustomerAuthorization[] @relation("CustomerAuthorizationRevokedBy")

  @@map("profiles")
}

// ─── Precio de la consulta (Creditia) — versionado en el tiempo ──
// Cada registro fija el valor unitario de una consulta. Solo uno debe estar
// activo a la vez (isActive); cambiar de precio = crear un registro nuevo y
// desactivar el anterior. El historial queda por createdAt/updatedAt. Cada
// AnalysisPack guarda el id del precio con el que se calculó, dejándolo
// congelado aunque el valor cambie después.

model ConsultationPrice {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(150)
  // unitPrice = precio FINAL por consulta. Es el valor que se usa en el cálculo
  // del precio del pack. El único descuento del sistema (por volumen) vive en
  // PackOffering; aquí no hay descuento.
  unitPrice     Float     @map("unit_price")
  currencyCode  String    @default("COP") @map("currency_code") @db.VarChar(10)
  taxRate       Decimal   @default(19) @map("tax_rate") @db.Decimal(5, 2)
  taxIncluded   Boolean   @default(true) @map("tax_included")
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdByAdmin       PlatformAdmin         @relation("ConsultationPriceCreatedBy", fields: [createdBy], references: [id])
  updatedByAdmin       PlatformAdmin?        @relation("ConsultationPriceUpdatedBy", fields: [updatedBy], references: [id])
  analysisPacks        AnalysisPack[]

  @@map("consultation_prices")
}

// ─── Empresa ────────────────────────────────────────────────

model Company {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  // nit/sector/ciudad/dirección son nullable: el onboarding solo pide el nombre
  // y estos se completan después en la app (gates por función: estudios, pagaré).
  nit              String?  @unique @db.VarChar(50)
  sectorId         Int?     @map("sector_id")
  cityCode         String?  @map("city_code") @db.VarChar(5)
  address          String?  @db.VarChar(255)
  accountTypeId    Int?     @map("account_type_id")
  accountBankId    Int?     @map("account_bank_id")
  accountNumber    String?  @map("account_number") @db.VarChar(50)
  logoUrl          String?  @map("logo_url") @db.VarChar(500)
  // ── Representante legal (quien obliga a la empresa) ──
  // NO es el usuario que se registró: se piden en el onboarding y son los datos
  // que van en los documentos. Nullable por las empresas previas a la columna.
  legalRepName                 String? @map("legal_rep_name") @db.VarChar(255)
  legalRepIdentificationTypeId Int?    @map("legal_rep_identification_type_id")
  legalRepIdentificationNumber String? @map("legal_rep_identification_number") @db.VarChar(50)
  legalRepEmail                String? @map("legal_rep_email") @db.VarChar(255)
  legalRepPhone                String? @map("legal_rep_phone") @db.VarChar(50)
  billingName      String?  @map("billing_name") @db.VarChar(150)
  billingLastName  String?  @map("billing_last_name") @db.VarChar(150)
  billingBusinessName String? @map("billing_business_name") @db.VarChar(255)
  billingDocTypeId Int?     @map("billing_doc_type_id")
  billingDocNumber String?  @map("billing_doc_number") @db.VarChar(50)
  billingEmail     String?  @map("billing_email") @db.VarChar(255)
  billingAddress   String?  @map("billing_address") @db.VarChar(255)
  billingCityCode  String?  @map("billing_city_code") @db.VarChar(5) // domicilio fiscal
  billingPhone     String?  @map("billing_phone") @db.VarChar(50)
  billingRegimeTypeId Int?  @map("billing_regime_type_id")
  billingFiscalResponsibilities String[] @default([]) @map("billing_fiscal_responsibilities")
  providerCustomerId String? @map("provider_customer_id") @db.VarChar(100) // id de cliente en el proveedor de pagos (hoy ePayco)
  isActive         Boolean  @default(true) @map("is_active")
  isOnboardingReady Boolean @default(false) @map("is_onboarding_ready")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sector               Parameter?            @relation("CompanySector", fields: [sectorId], references: [id])
  accountType          Parameter?            @relation("CompanyAccountType", fields: [accountTypeId], references: [id])
  accountBank          Parameter?            @relation("CompanyAccountBank", fields: [accountBankId], references: [id])
  billingDocType       Parameter?            @relation("CompanyBillingDocType", fields: [billingDocTypeId], references: [id])
  legalRepIdentificationType Parameter?      @relation("CompanyLegalRepIdentificationType", fields: [legalRepIdentificationTypeId], references: [id])
  billingRegimeType    Parameter?            @relation("CompanyBillingRegimeType", fields: [billingRegimeTypeId], references: [id])
  daneCity             DaneCity?             @relation("CompanyCity", fields: [cityCode], references: [code])
  billingDaneCity      DaneCity?             @relation("CompanyBillingCity", fields: [billingCityCode], references: [code])
  userCompanies        UserCompany[]
  invitations          Invitation[]
  customers            Customer[]
  creditStudies        CreditStudy[]
  aiAnalyses           AiAnalysis[]
  promissoryNotes      PromissoryNote[]
  notifications        Notification[]
  analysisPacks        AnalysisPack[]
  analysisConsumptions AnalysisConsumption[]
  paymentAlerts        PaymentAlert[]
  paymentEvents        PaymentEvent[]
  promoCodes           PromoCode[] // códigos atados a esta empresa (scope=company)
  promoRedemptions     PromoCodeRedemption[]
  supportTickets       SupportTicket[]
  bureauConsultations  CreditBureauConsultation[]
  financialPeriods     FinancialStatementPeriod[]
  financialAnalyses    FinancialAnalysis[]
  scoringConfigurations ScoringConfiguration[]
  customerAuthorizations CustomerAuthorization[]
  electronicInvoices     ElectronicInvoice[]
  // Uno por facturador (el @@unique es [provider, companyId]), no uno en total.
  einvoiceContactRefs    EInvoiceContactRef[]
  referral               CompanyReferral? // vendedor que la recomendó (si aplica)
  salesCommissions       SalesCommission[]

  @@map("companies")
}

// ─── Configuración de scoring del estudio (pesos por dimensión) ─────────
// Los pesos de las dimensiones del análisis de viabilidad NO son fijos: cada
// empresa define qué prioriza (capacidad de pago, veracidad, riesgo de central…)
// según su apetito de riesgo. Es VERSIONADA: una empresa acumula varias
// configuraciones en el tiempo (historial); una sola vigente (isActive=true).
// Al realizar un estudio se graba el id de la config vigente en el CreditStudy,
// congelando por referencia: reconfigurar después NO recalcula estudios viejos.
//
// Los pesos viven en scoring_configuration_weights (una fila por dimensión
// HABILITADA): deben sumar 100 y cada uno respeta un mínimo (MIN_WEIGHT). Una
// dimensión sin fila está deshabilitada y NO participa en el estudio. Los
// umbrales de veredicto (approved/conditional) NO se configuran: son fijos.

model ScoringConfiguration {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  // Tipo de persona al que aplica esta config (Parameter person_type:
  // naturalPerson | legalEntity). PN y PJ son perfiles de riesgo distintos: en PJ
  // pesa la veracidad (hay dos fuentes de EEFF); en PN pesa el riesgo de central
  // (no hay contraste posible). Cada empresa tiene UNA config vigente por tipo.
  personTypeId Int    @map("person_type_id")

  isActive  Boolean  @default(true) @map("is_active") // config vigente (por empresa+tipo)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  personType    Parameter     @relation("ScoringConfigurationPersonType", fields: [personTypeId], references: [id])
  createdByUser Profile       @relation("ScoringConfigurationCreatedBy", fields: [createdBy], references: [id])
  creditStudies CreditStudy[]
  // Dimensiones HABILITADAS por esta config con su peso. Suman 100.
  weights ScoringConfigurationWeight[]

  @@index([companyId, personTypeId, isActive])
  @@map("scoring_configurations")
}

// Catálogo global de dimensiones del scoring (lo administra Creditia desde el
// portal admin). Solo identidad y display: el COMPORTAMIENTO (función eval*,
// obligatoriedad, a qué tipo de persona aplica, defaults) vive en el motor,
// keyed por `code`. Sin borrado físico: retirar una dimensión del mercado =
// isActive false (las configs históricas que la usaban quedan íntegras).
model ScoringDimension {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50) // debe existir en SCORING_DIMENSIONS del motor
  label       String   @db.VarChar(150)
  description String?  @db.VarChar(500) // qué mide y por qué importa (tooltip en el front)
  isActive    Boolean  @default(true) @map("is_active") // elegible en el catálogo
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  weights ScoringConfigurationWeight[]

  @@map("scoring_dimensions")
}

// Peso de una dimensión dentro de una versión de configuración. La fila existe
// solo si la empresa HABILITÓ la dimensión en esa versión; sin fila, la
// dimensión no participa del estudio. Inmutable junto con su config (el
// versionado crea una config nueva con sus filas, nunca edita las históricas).
model ScoringConfigurationWeight {
  id          String @id @default(uuid()) @db.Uuid
  configId    String @map("config_id") @db.Uuid
  dimensionId Int    @map("dimension_id")
  weight      Int // >= MIN_WEIGHT; los de la config suman 100

  config    ScoringConfiguration @relation(fields: [configId], references: [id])
  dimension ScoringDimension     @relation(fields: [dimensionId], references: [id])

  @@unique([configId, dimensionId])
  @@map("scoring_configuration_weights")
}

// ─── Admin de plataforma (equipo Creditia / portal admin) ───

model PlatformAdmin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid // Supabase auth.users
  email     String   @db.VarChar(255)
  name      String?  @db.VarChar(150)
  lastName  String?  @map("last_name") @db.VarChar(150)
  phone     String?  @db.VarChar(50)
  // Identificación y domicilio. Hacen falta para el equipo interno (contratos,
  // pagos de comisiones a vendedores). Nullable: las cuentas creadas antes de
  // estas columnas no los tienen y no se obliga a completarlos retroactivamente.
  identificationTypeId Int?    @map("identification_type_id") // Parameter 'identification_type'
  identificationNumber String? @map("identification_number") @db.VarChar(50)
  address              String? @db.VarChar(255)
  // Municipio DANE. El departamento NO se guarda: se deriva de la ciudad
  // (daneCity.region), igual que en Company y Customer.
  cityCode             String? @map("city_code") @db.VarChar(5)
  // Rol del equipo interno Creditia (admin/support/sales). Parameter
  // 'platform_admin_role'. DISTINTO de los roles de empresa (UserCompany.role).
  roleId    Int?     @map("role_id")
  avatarUrl String?  @map("avatar_url") @db.VarChar(500) // foto del admin (autor de blog, etc.)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  role                      Parameter?          @relation("PlatformAdminRole", fields: [roleId], references: [id])
  identificationType        Parameter?          @relation("PlatformAdminIdentificationType", fields: [identificationTypeId], references: [id])
  daneCity                  DaneCity?           @relation("PlatformAdminCity", fields: [cityCode], references: [code])
  createdConsultationPrices ConsultationPrice[] @relation("ConsultationPriceCreatedBy")
  updatedConsultationPrices ConsultationPrice[] @relation("ConsultationPriceUpdatedBy")
  createdPackOfferings      PackOffering[]      @relation("PackOfferingCreatedBy")
  createdPromoCodes         PromoCode[]         @relation("PromoCodeCreatedBy")
  assignedContactRequests   ContactRequest[]    @relation("ContactRequestAssignedTo")
  handledContactRequests    ContactRequest[]    @relation("ContactRequestHandledBy")
  assignedSupportTickets    SupportTicket[]     @relation("SupportTicketAssignedTo")
  blogPosts                 BlogPost[]          @relation("BlogPostAuthor")
  einvoicedPacks            AnalysisPack[]      @relation("AnalysisPackEinvoiceMarkedBy")
  linkedEinvoiceContacts    EInvoiceContactRef[] @relation("EInvoiceContactLinkedBy")
  voidedElectronicInvoices  ElectronicInvoice[] @relation("ElectronicInvoiceVoidedBy")
  // Programa de referidos: su ficha de vendedor (solo rol 'sales') y su rastro
  // de gestión (planes creados, empresas vinculadas, comisiones liquidadas).
  salesRep                  SalesRep?           @relation("SalesRepPlatformAdmin")
  createdCommissionPlans    CommissionPlan[]    @relation("CommissionPlanCreatedBy")
  assignedReferrals         CompanyReferral[]   @relation("CompanyReferralAssignedBy")
  paidSalesCommissions      SalesCommission[]   @relation("SalesCommissionPaidBy")
  paidCommissionPayouts     CommissionPayout[]  @relation("CommissionPayoutPaidBy")
  revertedCommissionPayouts CommissionPayout[]  @relation("CommissionPayoutRevertedBy")

  @@map("platform_admins")
}

// ─── Catálogo de bolsas ofrecibles (configurable, lo que ve el front) ──
// Define las opciones de compra (2, 4, 8, 10 consultas...). El precio NO se
// guarda aquí: es derivado = quantity × ConsultationPrice.unitPrice vigente,
// menos un descuento por volumen opcional. El backend resuelve el precio al
// listar el catálogo; el front nunca lo calcula.

model PackOffering {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(150) // "Pack de 4 consultas"
  description    String?  @db.VarChar(500)
  quantity       Int // nº de consultas (análisis de crédito) incluidas
  // Vigencia que tendrá la bolsa al comprarse, en días. Hoy 365, configurable.
  validityDays   Int      @default(365) @map("validity_days")
  // Descuento por volumen OPCIONAL sobre el precio unitario base.
  // null/false = se cobra quantity × unitPrice sin descuento.
  hasDiscount    Boolean  @default(false) @map("has_discount")
  discountTypeId Int?     @map("discount_type_id") // Parameter 'discount_type': percentage | fixed
  discountValue  Float?   @map("discount_value") // 10 (=10%) o 5000 (=$5.000 menos)
  sortOrder      Int      @default(0) @map("sort_order")
  // Con qué ítem del catálogo facturable se emite. Sin esto no se puede facturar
  // la oferta: el facturador exige un código de producto que exista en su cuenta.
  einvoiceItemId String?  @map("einvoice_item_id") @db.Uuid
  // Único flag de visibilidad: si está en el catálogo ofrecible. Retirar una
  // oferta (isActive=false) la saca del catálogo sin borrarla ni romper las
  // AnalysisPack ya compradas que la referencian.
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdByAdmin PlatformAdmin? @relation("PackOfferingCreatedBy", fields: [createdBy], references: [id])
  discountType   Parameter?     @relation("PackOfferingDiscountType", fields: [discountTypeId], references: [id])
  einvoiceItem   EInvoiceItem?  @relation(fields: [einvoiceItemId], references: [id])
  analysisPacks  AnalysisPack[]

  @@map("pack_offerings")
}

// ─── Bolsa de análisis comprada (saldo prepago con vigencia) ──────────
// Una compra concreta de una empresa. Pago ÚNICO en ePayco (no recurrente).
// El precio se CONGELA al comprar (unitPricePaid/totalPaid), inmune a cambios
// posteriores del catálogo o del ConsultationPrice. El saldo disponible =
// quantityPurchased − quantityConsumed; quantityConsumed es un denormalizado
// del ledger AnalysisConsumption (la fuente de verdad es COUNT del ledger).

model AnalysisPack {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  packOfferingId      String?  @map("pack_offering_id") @db.Uuid // qué oferta del catálogo compró

  quantityPurchased   Int      @map("quantity_purchased")
  quantityConsumed    Int      @default(0) @map("quantity_consumed")

  // Vigencia (1 año por defecto; resuelta desde PackOffering.validityDays)
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date") @db.Date

  // Precio CONGELADO al momento de la compra
  unitPricePaid       Float    @map("unit_price_paid")
  totalPaid           Float    @map("total_paid")
  currencyCode        String   @default("COP") @map("currency_code") @db.VarChar(10)
  consultationPriceId String?  @map("consultation_price_id") @db.Uuid // precio que rigió (trazabilidad)

  statusId            Int      @map("status_id") // Parameter 'analysis_pack_status'

  // Proveedor de pagos (agnóstico; provider = quién procesó, hoy ePayco).
  // Pago ÚNICO vía Smart Checkout v2 (no suscripción recurrente).
  provider              String   @default("epayco") @db.VarChar(50)
  providerSessionId     String?  @map("provider_session_id") @db.VarChar(100) // sesión del checkout (1 por intento)
  // Referencia de factura enviada a la pasarela (x_id_factura). ÚNICA POR INTENTO:
  // ePayco rechaza un segundo pago con la misma invoice ("ya cuenta con un registro
  // previo"), así que al reintentar sobre la misma bolsa se genera una nueva.
  providerInvoice       String?  @map("provider_invoice") @db.VarChar(100)
  providerReference     String?  @map("provider_reference") @db.VarChar(100) // x_ref_payco
  providerTransactionId String?  @map("provider_transaction_id") @db.VarChar(100)
  // Datos del comprobante de pago (de la confirmación del proveedor), para
  // recibo, conciliación bancaria y soporte.
  providerFranchise      String?  @map("provider_franchise") @db.VarChar(20) // VS, MC, PSE...
  providerCardLast4      String?  @map("provider_card_last4") @db.VarChar(30) // ya enmascarado por el proveedor
  providerApprovalCode   String?  @map("provider_approval_code") @db.VarChar(40) // código de aprobación bancario
  providerResponseReason String?  @map("provider_response_reason") @db.VarChar(255) // motivo (útil si fue rechazado)
  paidAt              DateTime? @map("paid_at") // fecha/hora real del cobro (x_transaction_date)
  isTest              Boolean  @default(false) @map("is_test") // x_test_request: transacción de prueba
  // Secreto del link de pago (compra sin sesión); se invalida (null) al pagar.
  paymentToken        String?  @map("payment_token") @db.VarChar(64)

  // Código promocional aplicado (snapshot congelado en la fase 1 de la compra).
  // El canje real (PromoCodeRedemption) se crea al confirmarse el pago (webhook).
  // promoRedeemedBy se captura aquí porque el webhook no tiene usuario autenticado.
  promoCodeId          String?  @map("promo_code_id") @db.Uuid
  promoDiscountPercent Decimal? @map("promo_discount_percent") @db.Decimal(5, 2)
  promoDiscountAmount  Float?   @map("promo_discount_amount")
  promoRedeemedBy      String?  @map("promo_redeemed_by") @db.Uuid

  // Desglose fiscal CONGELADO al comprar (la tarifa puede cambiar cada año, y la
  // factura debe emitirse con la que rigió). Invariante: totalPaid = taxBase +
  // taxAmount. En una bolsa sin costo los tres quedan en 0.
  taxRatePaid Decimal? @map("tax_rate_paid") @db.Decimal(5, 2)
  taxBase     Float?   @map("tax_base")
  taxAmount   Float?   @map("tax_amount")
  // Si el precio del catálogo traía el IVA adentro. Se congela porque sin él no
  // se puede reconstruir el desglose de una bolsa vieja si la config cambia.
  taxIncludedPaid Boolean? @map("tax_included_paid")
  // Base gravable ANTES del código promocional. Es la base de la comisión del
  // vendedor: sobre lo cobrado, un descuento le costaría solo una fracción de lo
  // que regaló y el resto lo pondría Creditia.
  listTaxBase     Float?   @map("list_tax_base")

  // Facturación electrónica: se emite fuera del sistema y se marca aquí desde el
  // panel admin (mismo esquema que tenía payment_history antes de las bolsas).
  // Las bolsas sin costo NO entran a la cola: no hay nada que facturar.
  einvoiceSent     Boolean   @default(false) @map("einvoice_sent")
  einvoiceSentAt   DateTime? @map("einvoice_sent_at")
  einvoiceNumber   String?   @map("einvoice_number") @db.VarChar(100)
  einvoiceMarkedBy String?   @map("einvoice_marked_by") @db.Uuid // PlatformAdmin

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company           Company               @relation(fields: [companyId], references: [id])
  packOffering      PackOffering?         @relation(fields: [packOfferingId], references: [id])
  status            Parameter             @relation("AnalysisPackStatus", fields: [statusId], references: [id])
  consultationPrice ConsultationPrice?    @relation(fields: [consultationPriceId], references: [id])
  promoCode         PromoCode?            @relation(fields: [promoCodeId], references: [id])
  promoRedeemedByUser Profile?            @relation("AnalysisPackPromoRedeemedBy", fields: [promoRedeemedBy], references: [id])
  einvoiceMarkedByAdmin PlatformAdmin?    @relation("AnalysisPackEinvoiceMarkedBy", fields: [einvoiceMarkedBy], references: [id])
  consumptions      AnalysisConsumption[]
  paymentAlerts     PaymentAlert[]
  paymentEvents     PaymentEvent[]
  promoRedemptions  PromoCodeRedemption[]
  electronicInvoices ElectronicInvoice[]
  salesCommission   SalesCommission? // comisión causada por esta venta

  @@index([companyId, statusId, endDate]) // buscar bolsas vigentes con saldo (FIFO por endDate)
  @@index([statusId, paidAt]) // métricas de venta por fecha (admin-stats)
  @@index([einvoiceSent, paidAt]) // cola de facturación electrónica pendiente
  @@map("analysis_packs")
}

// ─── Consumo de un análisis (ledger) ──────────────────────────────────
// Una fila por CreditStudy creado. creditStudyId es @unique → 1:1 con el
// estudio (un estudio consume exactamente 1 crédito, no se puede doble-cobrar).
// El vínculo estudio↔bolsa vive AQUÍ, no en CreditStudy.

model AnalysisConsumption {
  id            String   @id @default(uuid()) @db.Uuid
  packId        String   @map("pack_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  creditStudyId String   @unique @map("credit_study_id") @db.Uuid
  consumedBy    String   @map("consumed_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  pack           AnalysisPack @relation(fields: [packId], references: [id])
  company        Company      @relation(fields: [companyId], references: [id])
  creditStudy    CreditStudy  @relation(fields: [creditStudyId], references: [id])
  consumedByUser Profile      @relation("AnalysisConsumptionConsumedBy", fields: [consumedBy], references: [id])

  @@index([companyId, createdAt])
  @@index([createdAt]) // serie temporal global de consumo (admin-stats)
  @@map("analysis_consumptions")
}

// ─── Permisos usuario ↔ empresa ─────────────────────────────

model UserCompany {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  roleId    Int       @map("role_id")
  isActive  Boolean   @default(true) @map("is_active")
  invitedBy String?   @map("invited_by") @db.Uuid
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user          Profile   @relation("UserCompanyUser", fields: [userId], references: [id])
  company       Company   @relation(fields: [companyId], references: [id])
  role          Parameter @relation("UserCompanyRole", fields: [roleId], references: [id])
  invitedByUser Profile?  @relation("UserCompanyInvitedBy", fields: [invitedBy], references: [id])

  @@unique([userId, companyId])
  @@index([companyId]) // listar miembros de una empresa (el unique empieza por userId y no sirve)
  @@map("user_companies")
}

// ─── Cliente (ficha propia por empresa) ─────────────────────

// El Customer NACE de una consulta a DataCrédito (no lo captura el usuario).
// Guarda la identidad estable del cliente + su "último estado ligero" conocido:
// datosBasicos (ambos tipos) e informacionDemografica (solo PN; en PJ va null).
// Los datos pesados de PJ (perfilGeneral, matrícula, rep. legal, junta, socios,
// malla, estados financieros) NO se normalizan aquí: viven en el snapshot crudo
// (CreditBureauConsultation.rawResponse) y, los que la app consume, en tablas de
// dominio (CustomerRiskSnapshot, FinancialStatement). Los campos con forma de
// proveedor los traduce experian.mapper.ts, nunca la app directamente.

model Customer {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  personTypeId         Int      @map("person_type_id")
  identificationTypeId Int?     @map("identification_type_id")
  businessName         String   @map("business_name") @db.VarChar(255) // razonSocial (PJ) o nombre completo (PN)
  identificationNumber String   @map("identification_number") @db.VarChar(50)
  verificationDigit    String?  @map("verification_digit") @db.VarChar(2) // dígito de verificación del NIT (PJ)
  economicActivityId   Int?     @map("economic_activity_id")

  // ── Nombres desglosados (PN; en PJ van null) ──────────
  firstName      String? @map("first_name") @db.VarChar(150)
  secondName     String? @map("second_name") @db.VarChar(150)
  firstLastName  String? @map("first_last_name") @db.VarChar(150)
  secondLastName String? @map("second_last_name") @db.VarChar(150)

  // ── Contacto (datosContacto PJ; PN puede ir null) ─────
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)
  address String? @db.VarChar(255)
  cityCode String? @map("city_code") @db.VarChar(5)
  bureauCity String? @map("bureau_city") @db.VarChar(150)

  // ── Información demográfica (solo PN; en PJ va null) ───
  birthDate      DateTime? @map("birth_date") @db.Date
  birthCity      String?   @map("birth_city") @db.VarChar(150)
  gender         String?   @db.VarChar(5)
  ageRange       String?   @map("age_range") @db.VarChar(10)
  documentStatus String?   @map("document_status") @db.VarChar(50) // estadoDocumento: Vigente, Cancelada...

  // ── Representante legal (solo PJ; editable, el refresh del bureau no lo pisa) ──
  // Sembrado en la 1ª consulta si la central lo trae; firma el pagaré de PJ.
  legalRepName                 String? @map("legal_rep_name") @db.VarChar(255)
  legalRepIdentificationTypeId Int?    @map("legal_rep_identification_type_id")
  legalRepIdentificationNumber String? @map("legal_rep_identification_number") @db.VarChar(50)
  legalRepEmail                String? @map("legal_rep_email") @db.VarChar(255)
  legalRepPhone                String? @map("legal_rep_phone") @db.VarChar(50)

  // ── Perfil PJ del bureau (solo PJ; en PN va null) ─────
  // Bloque de dominio (perfil general, matrícula, rep. legal, junta, revisoría,
  // socios, contacto) armado por el mapper con nombres propios (NO crudo del
  // proveedor). Es "estado actual" del cliente: se refresca en cada consulta.
  // El historial inmutable sigue en CreditBureauConsultation.rawResponse.
  bureauProfile   Json?     @map("bureau_profile") @db.JsonB

  // ── Trazabilidad de la consulta ───────────────────────
  bureauCreated   Boolean   @default(true) @map("bureau_created") // nació de una consulta al bureau
  lastConsultedAt DateTime? @map("last_consulted_at") // = última consultaAt exitosa

  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company                     @relation(fields: [companyId], references: [id])
  personType         Parameter                   @relation("CustomerPersonType", fields: [personTypeId], references: [id])
  identificationType Parameter?                  @relation("CustomerIdentificationType", fields: [identificationTypeId], references: [id])
  legalRepIdentificationType Parameter?          @relation("CustomerLegalRepIdentificationType", fields: [legalRepIdentificationTypeId], references: [id])
  economicActivity   Parameter?                  @relation("CustomerEconomicActivity", fields: [economicActivityId], references: [id])
  daneCity           DaneCity?                   @relation("CustomerCity", fields: [cityCode], references: [code])
  createdByUser      Profile                     @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  updatedByUser      Profile                     @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id])
  creditStudies      CreditStudy[]
  aiAnalyses         AiAnalysis[]
  promissoryNotes    PromissoryNote[]
  bureauConsultations CreditBureauConsultation[]
  riskSnapshots      CustomerRiskSnapshot[]
  financialPeriods   FinancialStatementPeriod[]
  financialAnalyses  FinancialAnalysis[]
  authorizations     CustomerAuthorization[]
  supportTickets     SupportTicket[]             @relation("SupportTicketCustomer")

  // Un cliente por identificación dentro de una empresa. Soporta el upsert de la
  // consulta al bureau (refrescar si existe, crear si no) de forma race-safe.
  @@unique([companyId, identificationNumber])
  @@index([companyId, businessName]) // listado (filtro por empresa + orden alfabético)
  @@map("customers")
}

// ─── Estudio de crédito ─────────────────────────────────────

// El estudio de crédito ya NO guarda las cifras crudas ni los indicadores
// derivados: las cifras viven en FinancialStatementPeriod (una fila por
// año/fuente, colgando del Customer) y los indicadores en FinancialAnalysis (un
// cálculo por par de períodos). El estudio CONGELA qué análisis usó mediante la
// join CreditStudyFinancialAnalysis (trazabilidad: si el cliente cambia su salud
// financiera en una consulta posterior, el estudio viejo sigue apuntando a los
// que se usaron cuando se hizo). Aquí quedan solo la SOLICITUD (cupo/plazo
// pedido) y el RESULTADO (viabilidad), que dependen de la solicitud y no del
// EEFF. La viabilidad se calcula en un endpoint separado.

model CreditStudy {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  statusId       Int       @map("status_id")
  studyDate      DateTime  @map("study_date") @db.Date
  resolutionDate DateTime? @map("resolution_date") @db.Date
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  notes          String?   @db.Text

  // ── Solicitud ──────────────────────────────────────────
  requestedTerm       Int?   @map("requested_term") // Plazo solicitado
  requestedCreditLine Float? @map("requested_credit_line") // Cupo total solicitado

  // ── Resultado / Viabilidad (lo llena el endpoint de cálculo) ──
  recommendedTerm       Int?    @map("recommended_term") // Plazo recomendado (días)
  recommendedCreditLine Float?  @map("recommended_credit_line") // Cupo recomendado ($)
  viabilityScore        Int?    @map("viability_score") // Score 0-100
  viabilityStatus       String? @map("viability_status") // 'approved' | 'conditional' | 'rejected'
  viabilityConditions   Json?   @map("viability_conditions") // JSON con dimensiones, alertas y resumen

  // Config de scoring con la que se realizó el análisis. Se graba al REALIZAR el
  // estudio (no al crearlo); nullable hasta entonces. Congela por referencia los
  // pesos usados → reconfigurar la empresa no recalcula este estudio.
  scoringConfigurationId String? @map("scoring_configuration_id") @db.Uuid

  customer            Customer                       @relation(fields: [customerId], references: [id])
  company             Company                        @relation(fields: [companyId], references: [id])
  status              Parameter                      @relation("CreditStudyStatus", fields: [statusId], references: [id])
  createdByUser       Profile                        @relation("CreditStudyCreatedBy", fields: [createdBy], references: [id])
  updatedByUser       Profile                        @relation("CreditStudyUpdatedBy", fields: [updatedBy], references: [id])
  scoringConfiguration ScoringConfiguration?         @relation(fields: [scoringConfigurationId], references: [id])
  aiAnalyses          AiAnalysis[]
  promissoryNotes     PromissoryNote[]
  analysisConsumption AnalysisConsumption?
  financialAnalyses   CreditStudyFinancialAnalysis[]
  resets              CreditStudyReset[]
  supportTickets      SupportTicket[]                @relation("SupportTicketCreditStudy")

  @@index([companyId, studyDate]) // listado principal y dashboard (orden por fecha)
  @@index([companyId, statusId]) // conteos/filtros por estado (dashboard)
  @@index([customerId]) // estudios de un cliente (ficha + métricas)
  @@map("credit_studies")
}

// ─── Reset de estudio (auditoría de soporte) ────────────────────────────
// Cuando la extracción del PDF leyó mal una cifra y el estudio ya quedó
// realizado, soporte (portal admin) resetea el estudio al paso 2 para que el
// usuario re-cargue los EEFF y re-analice SIN nueva consulta al bureau (el
// snapshot de riesgo vigente se reutiliza, sin consumo de bolsa). Antes de
// limpiar se congela aquí el estado previo COMPLETO (resultado + análisis
// financieros congelados), atado al ticket y al motivo. Append-only.
model CreditStudyReset {
  id            String @id @default(uuid()) @db.Uuid
  creditStudyId String @map("credit_study_id") @db.Uuid
  companyId     String @map("company_id") @db.Uuid

  // Ticket de soporte que originó el reset. Nullable: un reset puede nacer de
  // detección interna sin ticket formal.
  supportTicketId String? @map("support_ticket_id") @db.Uuid
  // Justificación del reset (obligatoria: es el "porqué" de la auditoría).
  reason String @db.Text

  // Estado previo completo: viability* del estudio, status, solicitud y los
  // análisis congelados que se desecharon (indicadores + ratios + períodos +
  // red flags). Forma libre JSONB: es archivo forense, la app no opera con él.
  snapshot Json

  // Usuario del portal admin que ejecutó el reset (PlatformAdmin.userId).
  resetBy   String   @map("reset_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  creditStudy   CreditStudy    @relation(fields: [creditStudyId], references: [id])
  supportTicket SupportTicket? @relation("SupportTicketResets", fields: [supportTicketId], references: [id])

  @@index([creditStudyId])
  @@index([supportTicketId]) // resets originados por un ticket
  @@index([companyId, createdAt]) // historial de resets por empresa
  @@map("credit_study_resets")
}

// ─── Período financiero del cliente (cifras crudas de UN año) ───────────
// EL HECHO: el balance/EERR de UN año fiscal, de UNA fuente. Pertenece al
// CLIENTE, no al estudio. Un cliente acumula varios: los que carga vía PDF y los
// que llegan de DataCrédito (o futuras fuentes). Append-only: cada extracción
// inserta filas nuevas aunque repitan año+fuente (trazabilidad de qué cifras se
// vieron en cada momento). Solo guarda cifras CRUDAS — NADA de indicadores: los
// indicadores dependen de DOS períodos y viven en FinancialAnalysis.

model FinancialStatementPeriod {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid

  // Origen de las cifras. 'pdf_upload' (cargado por el usuario) | 'datacredito'
  // (extraído de la respuesta MiDecisor) | otras fuentes futuras.
  source     String  @db.VarChar(30)
  fiscalYear Int     @map("fiscal_year") // año fiscal del estado (2024, 2023...)
  // Período del estado de resultados (mensual/anual): rige la anualización de
  // los cálculos. Parameter (income_statement).
  incomeStatementId Int?      @map("income_statement_id")
  balanceSheetDate  DateTime? @map("balance_sheet_date") @db.Date
  // Meses que abarca el ESTADO DE RESULTADOS de este período (1..12), leídos del
  // documento por la extracción IA. El balance es una foto a balanceSheetDate;
  // el ERI es un acumulado, y en cierres intermedios NO es de 12 meses. Rige la
  // capacidad de pago mensual y los días de las rotaciones. null = no se pudo
  // determinar → se cae al Parameter income_statement.
  statementMonths   Int?      @map("statement_months")

  // Si vino de una consulta al bureau, se ata al snapshot que lo originó
  // (trazabilidad de "estas cifras salieron de esta consulta").
  consultationId String? @map("consultation_id") @db.Uuid

  // Análisis al que pertenece este período. N períodos cuelgan de un análisis
  // (la extracción trae 2, 3 o más años). El corriente/anterior para los
  // indicadores se resuelve por fiscalYear DESC (no hay campo que los marque).
  analysisId String? @map("analysis_id") @db.Uuid

  // ── Balance General (cifras crudas) ────────────────────
  cashAndEquivalents            Float? @map("cash_and_equivalents")
  accountsReceivable            Float? @map("accounts_receivable")
  inventories                   Float? @map("inventories")
  totalCurrentAssets            Float? @map("total_current_assets")
  fixedAssetsProperty           Float? @map("fixed_assets_property")
  totalNonCurrentAssets         Float? @map("total_non_current_assets")
  totalAssets                   Float? @map("total_assets")
  shortTermFinancialLiabilities Float? @map("short_term_financial_liabilities")
  suppliers                     Float? @map("suppliers")
  totalCurrentLiabilities       Float? @map("total_current_liabilities")
  longTermFinancialLiabilities  Float? @map("long_term_financial_liabilities")
  totalNonCurrentLiabilities    Float? @map("total_non_current_liabilities")
  totalLiabilities              Float? @map("total_liabilities")
  retainedEarnings              Float? @map("retained_earnings")
  equity                        Float? @map("equity")

  // ── Estado de Resultados (cifras crudas) ───────────────
  ordinaryActivityRevenue Float? @map("ordinary_activity_revenue")
  costOfSales             Float? @map("cost_of_sales")
  grossProfit             Float? @map("gross_profit")
  administrativeExpenses  Float? @map("administrative_expenses")
  sellingExpenses         Float? @map("selling_expenses")
  depreciation            Float? @map("depreciation")
  amortization            Float? @map("amortization")
  financialExpenses       Float? @map("financial_expenses")
  taxes                   Float? @map("taxes")
  netIncome               Float? @map("net_income")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer        Customer                  @relation(fields: [customerId], references: [id])
  company         Company                   @relation(fields: [companyId], references: [id])
  incomeStatement Parameter?                @relation("FinancialStatementIncomeStatement", fields: [incomeStatementId], references: [id])
  consultation    CreditBureauConsultation? @relation(fields: [consultationId], references: [id])
  createdByUser   Profile                   @relation("FinancialStatementCreatedBy", fields: [createdBy], references: [id])
  analysis        FinancialAnalysis?        @relation("FinancialAnalysisPeriods", fields: [analysisId], references: [id])

  @@index([customerId, fiscalYear])
  @@index([companyId, createdAt])
  @@index([analysisId])
  @@map("financial_statement_periods")
}

// ─── Análisis financiero (indicadores de un PAR de períodos) ────────────
// EL CÁLCULO: los indicadores (EBITDA, factor de estabilidad, rotaciones,
// capacidad de pago) NO dependen de un año sino de DOS — el período corriente
// (EERR + saldos de cierre) y el anterior (saldo de apertura para promediar
// rotaciones). Por eso viven aquí y no en FinancialStatementPeriod. priorPeriod
// es opcional: si la fuente solo trajo un año, el anterior se toma como ceros.
// Los indicadores se derivan con computeFinancialIndicators (algoritmo Altman).

model FinancialAnalysis {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid

  // De qué fuente salió el conjunto de períodos (redundante con los períodos,
  // pero práctico para filtrar). 'pdf_upload' | 'datacredito' | ...
  source String @db.VarChar(30)

  // Los períodos (N años) cuelgan del análisis vía FinancialStatementPeriod.
  // analysisId. El corriente/anterior para los indicadores se resuelve por
  // fiscalYear DESC (los 2 más recientes). No hay FK fija a un par.

  // Red flags de fiabilidad detectadas por la IA al extraer el PDF. Atadas al
  // análisis que las originó (source='pdf_upload'). Vacío/null para datacredito.
  reliabilityFlags Json? @map("reliability_flags")

  // Ratios financieros estándar de presentación (ROA, ROE, márgenes, razón
  // corriente, prueba ácida, apalancamiento, crecimiento, variaciones, etc.).
  // NO alimentan la viabilidad: son para lectura del analista en el step2. Se
  // calculan igual para PDF y DataCrédito (columnas comparables). JSONB porque
  // es un bloque de display de forma evolutiva, no filtrable.
  ratios Json? @map("ratios")

  // ── Indicadores derivados del par de períodos ──────────
  stabilityFactor            Float? @map("stability_factor") // Factor de estabilidad (Z-score de Altman → escalón)
  ebitda                     Float? @map("ebitda")
  adjustedEbitda             Float? @map("adjusted_ebitda")
  currentDebtService         Float? @map("current_debt_service")
  annualPaymentCapacity      Float? @map("annual_payment_capacity")
  monthlyPaymentCapacity     Float? @map("monthly_payment_capacity")
  accountsReceivableTurnover Float? @map("accounts_receivable_turnover")
  inventoryTurnover          Float? @map("inventory_turnover")
  suppliersTurnover          Float? @map("suppliers_turnover")
  paymentTimeSuppliers       Float? @map("payment_time_suppliers")
  accountsPayableTurnover    Float? @map("accounts_payable_turnover")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer      Customer                 @relation(fields: [customerId], references: [id])
  company       Company                  @relation(fields: [companyId], references: [id])
  createdByUser Profile                  @relation("FinancialAnalysisCreatedBy", fields: [createdBy], references: [id])
  periods       FinancialStatementPeriod[] @relation("FinancialAnalysisPeriods")
  creditStudies CreditStudyFinancialAnalysis[]

  @@index([customerId, createdAt])
  @@index([companyId, createdAt])
  @@map("financial_analyses")
}

// ─── Join: qué análisis financieros usó cada estudio (congelación) ──────
// N:M explícita entre CreditStudy y FinancialAnalysis. Al crear el estudio se
// listan aquí los análisis que se consideraron; queda CONGELADO: aunque después
// lleguen EEFF nuevos al cliente, el estudio sigue apuntando a los suyos.

model CreditStudyFinancialAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  creditStudyId       String   @map("credit_study_id") @db.Uuid
  financialAnalysisId String   @map("financial_analysis_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  creditStudy       CreditStudy       @relation(fields: [creditStudyId], references: [id])
  financialAnalysis FinancialAnalysis @relation(fields: [financialAnalysisId], references: [id])

  @@unique([creditStudyId, financialAnalysisId])
  @@index([financialAnalysisId])
  @@map("credit_study_financial_analyses")
}

// ─── Consulta a central de riesgo (snapshot crudo, append-only) ─────────
// CAPA DE ARCHIVO de la integración con DataCrédito Experian (MiDecisor). Una
// fila por cada llamada que devolvió información. Es la prueba literal de qué
// dijo la central ese día: rawResponse guarda la respuesta COMPLETA sin trocear
// ni interpretar, de modo que absorbe cambios de forma del proveedor sin
// migración. La app NUNCA lee de aquí para operar: para eso están las tablas de
// dominio (Customer, CustomerRiskSnapshot, FinancialStatement), pobladas por el
// traductor experian.mapper.ts. Nunca se actualiza. Solo se escribe cuando la
// consulta trajo datos (conInformacion=true); sin datos → no se persiste nada.

model CreditBureauConsultation {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  createdBy  String @map("created_by") @db.Uuid
  provider   String @default("experian") @db.VarChar(30)

  personType String @map("person_type") @db.VarChar(5) // 'PN' | 'PJ'

  // ── infoTransaccion (metadata de la llamada / bitácora) ──
  consultaAt       DateTime @map("consulta_at") // fecha/hora de la consulta según la central
  tipoIdDigitado   String   @map("tipo_id_digitado") @db.VarChar(10)
  numeroIdDigitado String   @map("numero_id_digitado") @db.VarChar(50)
  txCode           String?  @map("tx_code") @db.VarChar(5) // codigosRespuesta TX (02, 17...)
  codigosRespuesta Json?    @map("codigos_respuesta") @db.JsonB // [{clave,valor}] CC/HC/DE/SS...
  // Tabla 1: [{clave,valor,descripcion}] — descripción del manual solo para clave TX.
  codigosRespuestaLabeled Json? @map("codigos_respuesta_labeled") @db.JsonB
  httpStatus       Int      @map("http_status")

  // ── Archivo crudo (respuesta COMPLETA, literal) ──
  rawResponse Json @map("raw_response") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  company             Company              @relation(fields: [companyId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  createdByUser       Profile              @relation("CreditBureauConsultationCreatedBy", fields: [createdBy], references: [id])
  riskSnapshot        CustomerRiskSnapshot?
  financialPeriods    FinancialStatementPeriod[]

  @@index([customerId, consultaAt]) // "última consulta de este customer"
  @@index([companyId, createdAt])
  @@map("credit_bureau_consultations")
}

// ─── Foto de riesgo del cliente por consulta (dominio, inmutable) ───────
// CAPA DE DOMINIO: los campos de riesgo/comportamiento que la app consume,
// traducidos a nombres propios por experian.mapper.ts (no dialecto del
// proveedor). Una fila 1:1 con cada consulta → historial de cómo evolucionó el
// riesgo del cliente. "Riesgo actual" = el snapshot más reciente. Promoción
// incremental: solo se traduce lo que la app usa hoy; el resto queda dormido en
// CreditBureauConsultation.rawResponse, listo para promoverse después.

model CustomerRiskSnapshot {
  id             String @id @default(uuid()) @db.Uuid
  consultationId String @unique @map("consultation_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  // Campos promovidos (algunos aplican solo a PN o solo a PJ → el otro va null)
  score           Int? // PN: informacionRiesgo.score / PJ: puntajeScore
  viabilidad      String? @db.VarChar(20) // PN
  ratingRecaudos  String? @map("rating_recaudos") @db.VarChar(5) // PN
  nivelRiesgo     String? @map("nivel_riesgo") @db.VarChar(20) // PJ: nivel
  ratingSectorial String? @map("rating_sectorial") @db.VarChar(20) // PJ
  montoSugerido   Float?  @map("monto_sugerido")
  saldoActual     Float?  @map("saldo_actual") // indicadoresValores.saldoActual
  porcentajeDeuda Float?  @map("porcentaje_deuda")
  saldoMora       Float?  @map("saldo_mora")
  hasAlertas      Boolean @default(false) @map("has_alertas")

  // Endeudamiento reportado (solo PN): ingreso mensual y % del ingreso ya
  // comprometido en cuotas. Referencia de capacidad de pago de la persona (la
  // central no tiene EEFF de PN). null en PJ.
  reportedIncome   Float? @map("reported_income")
  quotaToIncomePct Float? @map("quota_to_income_pct")

  // Descripciones del manual Experian para los códigos escalares de riesgo
  // (Tablas 11-14). El código crudo vive en su columna; el label es puro display.
  viabilidadLabel      String? @map("viabilidad_label") @db.VarChar(80) // Tabla 11 (PN)
  ratingRecaudosLabel  String? @map("rating_recaudos_label") @db.VarChar(255) // Tabla 12 (PN)
  nivelRiesgoLabel     String? @map("nivel_riesgo_label") @db.VarChar(80) // Tabla 13 (PJ)
  ratingSectorialLabel String? @map("rating_sectorial_label") @db.VarChar(80) // Tabla 14 (PJ)

  // Bloques temporales de la consulta (listas/árbol con su descripción). JSONB
  // porque cambian por consulta y su forma es una lista; se archivan aquí para
  // conservar el histórico por snapshot (no en Customer, que se sobrescribe).
  creditPortfolio Json? @map("credit_portfolio") // Tabla 8  (PJ): tipos de crédito
  paymentBehavior Json? @map("payment_behavior") // Tabla 9  (PN+PJ): vector mensual
  creditSectors   Json? @map("credit_sectors") // Tabla 10 (PN+PJ): sectores
  linkNetwork     Json? @map("link_network") // Tabla 15 (PJ): malla de vínculos
  alerts          Json? @map("alerts") // detalle de alertas (PN: textos; PJ: nodos alertados)
  suggestions     Json? @map("suggestions") // checklist de verificación de la central ([{title, items[]}])

  createdAt DateTime @default(now()) @map("created_at")

  consultation CreditBureauConsultation @relation(fields: [consultationId], references: [id])
  customer     Customer                 @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_risk_snapshots")
}

// ─── Análisis de IA ──────────────────────────────────────────


// ─── Alertas de pago (incidentes que el admin debe gestionar) ──────────
// Registro de incidentes de cobro que requieren contacto con el cliente
// (p.ej. pago reversado). Fuente de verdad del incidente: los correos son
// best-effort. type/severity/status son Parameter (payment_alert_type,
// payment_alert_severity, payment_alert_status).

model PaymentAlert {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  analysisPackId String?  @map("analysis_pack_id") @db.Uuid
  typeId         Int      @map("type_id")
  severityId     Int      @map("severity_id")
  statusId       Int      @map("status_id")
  title          String   @db.VarChar(255)
  message        String   @db.Text
  metadata       Json?    @db.JsonB // ref ePayco, monto, créditos consumidos, etc.
  resolvedBy     String?  @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id])
  analysisPack  AnalysisPack? @relation(fields: [analysisPackId], references: [id])
  type          Parameter     @relation("PaymentAlertType", fields: [typeId], references: [id])
  severity      Parameter     @relation("PaymentAlertSeverity", fields: [severityId], references: [id])
  status        Parameter     @relation("PaymentAlertStatus", fields: [statusId], references: [id])
  resolvedByUser Profile?     @relation("PaymentAlertResolvedBy", fields: [resolvedBy], references: [id])

  @@index([companyId, statusId])
  @@index([statusId, createdAt])
  @@map("payment_alerts")
}

// ─── Eventos de pago de ePayco (log crudo por confirmación) ────────────
// Una fila por CADA confirmación que ePayco envía al webhook (rechazo, pago,
// reversa...). Guarda el payload CRUDO completo para auditoría/debug y soporte
// de disputas. A diferencia de AnalysisPack (1 fila por bolsa), aquí se conserva
// el historial de TODOS los intentos. No se actualiza: es append-only.

model PaymentEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  analysisPackId        String?  @map("analysis_pack_id") @db.Uuid // bolsa (x_extra1); null si no se identificó
  companyId             String?  @map("company_id") @db.Uuid
  provider              String   @default("epayco") @db.VarChar(50) // proveedor de pagos que emitió el evento
  providerReference     String?  @map("provider_reference") @db.VarChar(100) // x_ref_payco
  providerTransactionId String?  @map("provider_transaction_id") @db.VarChar(100)
  codResponse         Int?     @map("cod_response") // 1=aceptada 2=rechazada 4=fallida 6=reversada...
  responseText        String?  @map("response_text") @db.VarChar(255)
  amount              Float?
  currencyCode        String?  @map("currency_code") @db.VarChar(10)
  isTest              Boolean  @default(false) @map("is_test")
  payload             Json     @db.JsonB // payload crudo COMPLETO de ePayco
  createdAt           DateTime @default(now()) @map("created_at")

  analysisPack AnalysisPack? @relation(fields: [analysisPackId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])

  @@index([analysisPackId, createdAt])
  @@index([providerTransactionId])
  @@map("payment_events")
}

// ─── Códigos promocionales ─────────────────────────────────────────────
// Otorgan un descuento porcentual sobre la compra de una bolsa (sobre el total,
// después del descuento por volumen del PackOffering). Dos modos según scope:
//   'company' → atado a UNA empresa (companyId), maxRedemptions = 1.
//   'global'  → cualquier empresa, maxRedemptions = N; cada empresa lo usa 1 vez.
// El código es "usable" si: isActive && redemptionsCount < maxRedemptions &&
// (sin fechas o dentro de validFrom/validUntil). No hay flag "agotado": se deriva.
// El canje real (consumir cupo) ocurre al CONFIRMARSE el pago (webhook), no al
// iniciar la compra; una reversa libera el cupo.

model PromoCode {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique @db.VarChar(50) // normalizado a UPPERCASE
  scopeId          Int       @map("scope_id") // Parameter 'promo_code_scope'
  appliesToId      Int       @map("applies_to_id") // Parameter 'promo_code_applies_to'
  companyId        String?   @map("company_id") @db.Uuid // solo scope=company
  // Vendedor que FINANCIA el descuento: el monto se resta de su comisión. NULL =
  // lo pone Creditia (campañas de marketing) y no afecta a ningún vendedor.
  // Un código de vendedor solo lo puede canjear una empresa YA vinculada a ÉL:
  // el código descuenta, nunca atribuye (eso es del código de vendedor).
  salesRepId       String?   @map("sales_rep_id") @db.Uuid
  discountPercent  Decimal   @map("discount_percent") @db.Decimal(5, 2) // inmutable
  maxRedemptions   Int       @map("max_redemptions") // cupo total
  redemptionsCount Int       @default(0) @map("redemptions_count") // denorm del ledger
  validFrom        DateTime? @map("valid_from")
  validUntil       DateTime? @map("valid_until")
  isActive         Boolean   @default(true) @map("is_active")
  description      String?   @db.VarChar(255) // nota interna
  createdBy        String?   @map("created_by") @db.Uuid // PlatformAdmin
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  scope          Parameter             @relation("PromoCodeScope", fields: [scopeId], references: [id])
  appliesTo      Parameter             @relation("PromoCodeAppliesTo", fields: [appliesToId], references: [id])
  company        Company?              @relation(fields: [companyId], references: [id])
  salesRep       SalesRep?             @relation("PromoCodeSalesRep", fields: [salesRepId], references: [id])
  createdByAdmin PlatformAdmin?        @relation("PromoCodeCreatedBy", fields: [createdBy], references: [id])
  redemptions    PromoCodeRedemption[]
  analysisPacks  AnalysisPack[]

  // (sin @@index([code]): code ya es @unique y ese índice lo cubre)
  @@index([scopeId, isActive])
  @@index([salesRepId]) // "mis códigos" en el panel del vendedor
  @@map("promo_codes")
}

// ─── Canjes de código promocional (ledger append-only) ─────────────────
// Una fila por cada canje confirmado. Fuente de verdad del cupo (redemptionsCount
// en PromoCode es la copia desnormalizada). El @@unique([promoCodeId, companyId])
// garantiza a nivel BD que una empresa canjea un código una sola vez. Guarda un
// snapshot del % y monto descontado por si el código cambia/desactiva después.

model PromoCodeRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  promoCodeId     String   @map("promo_code_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  analysisPackId  String?  @map("analysis_pack_id") @db.Uuid // bolsa donde se aplicó
  redeemedBy      String?  @map("redeemed_by") @db.Uuid // Profile (usuario de empresa)
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2) // snapshot
  discountAmount  Float    @map("discount_amount") // snapshot en COP
  redeemedAt      DateTime @default(now()) @map("redeemed_at")

  promoCode      PromoCode     @relation(fields: [promoCodeId], references: [id])
  company        Company       @relation(fields: [companyId], references: [id])
  analysisPack   AnalysisPack? @relation(fields: [analysisPackId], references: [id])
  redeemedByUser Profile?      @relation("PromoCodeRedemptionRedeemedBy", fields: [redeemedBy], references: [id])

  @@unique([promoCodeId, companyId]) // una empresa canjea un código solo 1 vez
  @@index([promoCodeId, redeemedAt])
  @@map("promo_code_redemptions")
}

// ─── Programa de referidos (vendedores y comisiones) ───────────────────
// Una persona externa recomienda Creditia; cuando la empresa recomendada compra,
// esa persona gana un % de lo facturado. Cuatro piezas:
//   CommissionPlan  → los dos porcentajes vigentes (nuevo vs recompra)
//   SalesRep        → el vendedor y su CÓDIGO
//   CompanyReferral → qué vendedor trajo qué empresa (+ % congelados)
//   SalesCommission → ledger: una fila por bolsa pagada de una empresa referida

// Plan de comisiones VIGENTE. Versionado igual que ConsultationPrice: cambiar
// los porcentajes NO edita el plan, crea uno nuevo y desactiva el anterior. Las
// vinculaciones y comisiones ya causadas apuntan a su plan y guardan su propio
// %, así que un cambio de tarifa nunca reescribe el pasado.
model CommissionPlan {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150) // "Plan 2026" — etiqueta de la versión

  // % sobre la PRIMERA compra facturada de una empresa referida (el 30%).
  newCustomerPercent Decimal @map("new_customer_percent") @db.Decimal(5, 2)
  // % sobre TODA recompra posterior, sin fecha de caducidad (el 10%).
  recurringPercent   Decimal @map("recurring_percent") @db.Decimal(5, 2)

  // Techo del descuento que un vendedor puede otorgar en sus propios códigos.
  // El descuento se resta de SU comisión, así que a este tope su ganancia de la
  // primera venta queda en cero. Bajarlo obliga a que siempre conserve algo y
  // defiende el precio de lista.
  maxNewCustomerDiscount Decimal @default(30) @map("max_new_customer_discount") @db.Decimal(5, 2)

  isActive  Boolean  @default(true) @map("is_active") // solo uno vigente
  notes     String?  @db.VarChar(500)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdByAdmin PlatformAdmin?    @relation("CommissionPlanCreatedBy", fields: [createdBy], references: [id])
  referrals      CompanyReferral[]
  commissions    SalesCommission[]

  @@index([isActive])
  @@map("commission_plans")
}

// Vendedor del programa. 1:1 con su cuenta del portal (PlatformAdmin con rol
// 'sales' o 'admin' — alguien de Creditia también puede vender): entra al panel
// con su usuario y ve SUS ganancias mes a mes. El
// `code` es lo que se teclea al vincular una empresa. Sin borrado físico:
// isActive=false lo retira sin tocar sus comisiones históricas.
model SalesRep {
  id              String @id @default(uuid()) @db.Uuid
  platformAdminId String @unique @map("platform_admin_id") @db.Uuid
  code            String @unique @db.VarChar(30) // normalizado a UPPERCASE

  isActive  Boolean  @default(true) @map("is_active")
  notes     String?  @db.VarChar(500) // nota interna (acuerdo, contacto…)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  platformAdmin PlatformAdmin     @relation("SalesRepPlatformAdmin", fields: [platformAdminId], references: [id])
  referrals     CompanyReferral[]
  commissions   SalesCommission[]
  promoCodes    PromoCode[]       @relation("PromoCodeSalesRep")
  payouts       CommissionPayout[]

  @@map("sales_reps")
}

// Vinculación empresa ↔ vendedor. companyId es @unique: una empresa la trae UN
// solo vendedor (si se corrige, se reasigna la misma fila). Congela los % que
// regían al vincular, de modo que la empresa mantiene las condiciones con las
// que se cerró aunque después cambie el plan global.
model CompanyReferral {
  companyId        String @id @map("company_id") @db.Uuid
  salesRepId       String @map("sales_rep_id") @db.Uuid
  commissionPlanId String @map("commission_plan_id") @db.Uuid

  // Snapshot de los % del plan al momento de vincular.
  newCustomerPercent Decimal @map("new_customer_percent") @db.Decimal(5, 2)
  recurringPercent   Decimal @map("recurring_percent") @db.Decimal(5, 2)

  assignedBy String?  @map("assigned_by") @db.Uuid // PlatformAdmin que la vinculó
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id])
  salesRep       SalesRep       @relation(fields: [salesRepId], references: [id])
  commissionPlan CommissionPlan @relation(fields: [commissionPlanId], references: [id])
  assignedByAdmin PlatformAdmin? @relation("CompanyReferralAssignedBy", fields: [assignedBy], references: [id])

  commissions SalesCommission[]

  @@index([salesRepId])
  @@map("company_referrals")
}

// Ledger de comisiones (append-only). Una fila por bolsa pagada de una empresa
// referida; analysisPackId es @unique → una venta jamás comisiona dos veces,
// aunque el webhook de pago llegue repetido.
//
// El monto se calcula sobre la base gravable de LISTA (antes de descuentos): el
// IVA no es ingreso de Creditia. Si el descuento lo financió el propio vendedor
// con uno de sus códigos, se le resta de la comisión:
//
//   neta = max(0, % × baseDeLista − descuentoQueÉlOtorgó)
//
// Con eso el neto de Creditia no se mueve por más descuento que dé el vendedor:
// cambia comisión por cierre 1 a 1. Un código de Creditia (salesRepId NULL) no
// le descuenta nada. Las bolsas sin costo (código del 100%) NO generan fila.
model SalesCommission {
  id                String @id @default(uuid()) @db.Uuid
  analysisPackId    String @unique @map("analysis_pack_id") @db.Uuid
  salesRepId        String @map("sales_rep_id") @db.Uuid
  companyId         String @map("company_id") @db.Uuid
  companyReferralId String @map("company_referral_id") @db.Uuid
  commissionPlanId  String @map("commission_plan_id") @db.Uuid

  // 'new' = primera compra FACTURADA de la empresa | 'recurring' = recompra.
  // Clasificación calculada, no un catálogo que el admin edite → VarChar.
  kind String @db.VarChar(20)

  // Todo congelado al causar: si mañana cambia el plan, esta fila no se mueve.
  percentApplied   Decimal @map("percent_applied") @db.Decimal(5, 2)
  baseAmount       Float   @map("base_amount") // taxBase COBRADA (concilia con la factura)
  commissionAmount Float   @map("commission_amount") // NETA: lo que se le paga
  currencyCode     String  @default("COP") @map("currency_code") @db.VarChar(10)

  // Desglose de la liquidación. Sin descuento del vendedor, bruta = neta y
  // financiado = 0, que es como quedaron las filas anteriores a esta función.
  listBaseAmount        Float @default(0) @map("list_base_amount") // base de lista (sin descuento)
  grossCommissionAmount Float @default(0) @map("gross_commission_amount") // % × base de lista
  discountFundedAmount  Float @default(0) @map("discount_funded_amount") // lo que puso de su bolsillo

  // Mes de causación 'YYYY-MM' precalculado en hora de Colombia. Se guarda
  // resuelto (y no se deriva en cada query) para que agrupar por mes no dependa
  // del huso del servidor: una venta del 31 a las 8pm es de ESE mes, no del
  // siguiente en UTC.
  accrualMonth String   @map("accrual_month") @db.VarChar(7)
  accruedAt    DateTime @default(now()) @map("accrued_at")

  statusId Int @map("status_id") // Parameter 'sales_commission_status'

  // Liquidación: cuándo se le pagó al vendedor y quién lo marcó.
  paidAt      DateTime? @map("paid_at")
  paidBy      String?   @map("paid_by") @db.Uuid
  payoutNotes String?   @map("payout_notes") @db.VarChar(500)
  // Lote en el que se liquidó, si se pagó en bloque. NULL = se marcó suelta.
  // Una comisión de un lote NO se revierte sola: se revierte el lote entero, o
  // el total del comprobante dejaría de cuadrar con lo que suman sus líneas.
  payoutId    String?   @map("payout_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  analysisPack    AnalysisPack    @relation(fields: [analysisPackId], references: [id])
  salesRep        SalesRep        @relation(fields: [salesRepId], references: [id])
  company         Company         @relation(fields: [companyId], references: [id])
  companyReferral CompanyReferral @relation(fields: [companyReferralId], references: [companyId])
  commissionPlan  CommissionPlan  @relation(fields: [commissionPlanId], references: [id])
  status          Parameter       @relation("SalesCommissionStatus", fields: [statusId], references: [id])
  paidByAdmin     PlatformAdmin?  @relation("SalesCommissionPaidBy", fields: [paidBy], references: [id])
  payout          CommissionPayout? @relation(fields: [payoutId], references: [id])

  @@index([salesRepId, accrualMonth]) // "mis ganancias del mes"
  @@index([accrualMonth]) // consolidado global mes a mes
  @@index([statusId, accrualMonth]) // cola de pendientes por liquidar
  @@index([payoutId]) // líneas de un comprobante
  @@map("sales_commissions")
}

// ─── Lotes de liquidación ──────────────────────────────────────────────
// Al vendedor se le paga UNA transferencia por todas sus comisiones del mes, no
// una por venta. Cada lote es ese giro: agrupa N comisiones, guarda el total y
// da una referencia estable para el comprobante que se le envía.
//
// Revertir es a nivel de lote (un giro se devuelve entero): sus comisiones
// vuelven a 'pending' y el lote queda marcado como revertido, sin borrarse, para
// que el histórico muestre que existió.

model CommissionPayout {
  id         String @id @default(uuid()) @db.Uuid
  reference  String @unique @db.VarChar(30) // PAY-202608-0001, va en el comprobante
  salesRepId String @map("sales_rep_id") @db.Uuid

  // Snapshot al liquidar: qué se pagó y cuánto. No se recalcula desde las
  // líneas, para que el comprobante emitido siga diciendo lo mismo siempre.
  commissionCount Int    @map("commission_count")
  totalAmount     Float  @map("total_amount")
  currencyCode    String @default("COP") @map("currency_code") @db.VarChar(10)

  // Rango que cubre el giro, para el comprobante ('YYYY-MM').
  fromMonth String? @map("from_month") @db.VarChar(7)
  toMonth   String? @map("to_month") @db.VarChar(7)

  notes  String?  @db.VarChar(500) // nº de transferencia, banco, fecha del giro
  paidAt DateTime @default(now()) @map("paid_at")
  paidBy String?  @map("paid_by") @db.Uuid

  // Reversión (giro devuelto o liquidación equivocada). No se borra la fila.
  revertedAt   DateTime? @map("reverted_at")
  revertedBy   String?   @map("reverted_by") @db.Uuid
  revertReason String?   @map("revert_reason") @db.VarChar(500)

  // Envío del comprobante al vendedor (best-effort, no bloquea la liquidación).
  receiptSentAt DateTime? @map("receipt_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  salesRep       SalesRep       @relation(fields: [salesRepId], references: [id])
  paidByAdmin    PlatformAdmin? @relation("CommissionPayoutPaidBy", fields: [paidBy], references: [id])
  revertedByAdmin PlatformAdmin? @relation("CommissionPayoutRevertedBy", fields: [revertedBy], references: [id])
  commissions    SalesCommission[]

  @@index([salesRepId, paidAt])
  @@map("commission_payouts")
}

// ─── Contacto comercial (leads del formulario público) ─────────────────
// Cada fila es una solicitud enviada desde el formulario público de "contactar
// ventas" (sin auth). subject/status son Parameter. Los campos de gestión
// (assignedTo/handledBy/handledAt/notes) convierten el buzón en un mini-CRM:
// el equipo comercial puede asignar, atender y cerrar cada lead desde el panel.

model ContactRequest {
  id          String   @id @default(uuid()) @db.Uuid
  subjectId   Int      @map("subject_id") // Parameter 'contact_subject'
  companyName String   @map("company_name") @db.VarChar(255)
  fullName    String   @map("full_name") @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String   @db.VarChar(50)
  message     String   @db.Text

  // Gestión (panel admin)
  statusId    Int      @map("status_id") // Parameter 'contact_status'; nace en 'new'
  assignedTo  String?  @map("assigned_to") @db.Uuid // PlatformAdmin que lo atiende
  handledBy   String?  @map("handled_by") @db.Uuid // PlatformAdmin que lo cerró
  handledAt   DateTime? @map("handled_at")
  notes       String?  @db.Text

  // Captura técnica (anti-spam / seguimiento)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject        Parameter      @relation("ContactRequestSubject", fields: [subjectId], references: [id])
  status         Parameter      @relation("ContactRequestStatus", fields: [statusId], references: [id])
  assignedToAdmin PlatformAdmin? @relation("ContactRequestAssignedTo", fields: [assignedTo], references: [id])
  handledByAdmin  PlatformAdmin? @relation("ContactRequestHandledBy", fields: [handledBy], references: [id])

  @@index([statusId, createdAt])
  @@index([subjectId])
  @@map("contact_requests")
}

// ─── Tickets de soporte (de empresas a Creditia) ───────────────────────
// Cada ticket pertenece a una empresa (Company 1→N). area/type/priority/status
// son Parameter. relatedEntityType/Id apuntan opcionalmente a un registro
// (estudio, cliente, pago): un CHECK en BD exige que sean ambos null o ambos
// presentes. reference es un código legible único (SUP-AAAA-######) generado por
// el servidor con un contador atómico (SupportTicketCounter). Gestión: status,
// assignedTo (PlatformAdmin) y notas internas.

model SupportTicket {
  id                String   @id @default(uuid()) @db.Uuid
  reference         String   @unique @db.VarChar(30) // SUP-2026-000123
  companyId         String   @map("company_id") @db.Uuid
  areaId            Int      @map("area_id") // Parameter 'support_area'
  typeId            Int      @map("type_id") // Parameter 'support_type'
  priorityId        Int      @map("priority_id") // Parameter 'support_priority'
  statusId          Int      @map("status_id") // Parameter 'support_status'; nace en 'open'
  subject           String   @db.VarChar(255)
  description       String   @db.Text

  // Registro relacionado por FK TIPADA según el área (validado en el servicio):
  // area credit_study → creditStudyId obligatorio (customerId se deriva del
  // estudio); area customer → customerId obligatorio; payment/account/other no
  // llevan id extra (companyId ya ata el ticket al tenant). Reemplaza al viejo
  // par polimórfico related_entity_type/related_entity_id (sin integridad).
  creditStudyId String? @map("credit_study_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid

  // Contexto técnico que envía el front (ruta, userAgent, viewport, etc.).
  context           Json?    @db.JsonB

  // Gestión (panel admin)
  assignedTo        String?  @map("assigned_to") @db.Uuid // PlatformAdmin
  notes             String?  @db.Text

  createdBy         String   @map("created_by") @db.Uuid // Profile (usuario de empresa)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id])
  area            Parameter      @relation("SupportTicketArea", fields: [areaId], references: [id])
  type            Parameter      @relation("SupportTicketType", fields: [typeId], references: [id])
  priority        Parameter      @relation("SupportTicketPriority", fields: [priorityId], references: [id])
  status          Parameter      @relation("SupportTicketStatus", fields: [statusId], references: [id])
  assignedToAdmin PlatformAdmin? @relation("SupportTicketAssignedTo", fields: [assignedTo], references: [id])
  createdByUser   Profile        @relation("SupportTicketCreatedBy", fields: [createdBy], references: [id])
  creditStudy     CreditStudy?   @relation("SupportTicketCreditStudy", fields: [creditStudyId], references: [id])
  customer        Customer?      @relation("SupportTicketCustomer", fields: [customerId], references: [id])
  // Resets de estudio ejecutados a raíz de este ticket (auditoría).
  creditStudyResets CreditStudyReset[] @relation("SupportTicketResets")

  @@index([companyId, createdAt])
  @@index([statusId, createdAt])
  @@index([creditStudyId]) // tickets de un estudio
  @@index([customerId]) // tickets de un cliente
  @@map("support_tickets")
}

// Contador atómico para el reference de los tickets, uno por año. Se incrementa
// con UPDATE ... RETURNING dentro de una transacción para evitar duplicados en
// concurrencia. No lo gestiona ningún CRUD: lo usa solo la generación del reference.

model SupportTicketCounter {
  year     Int @id // p.ej. 2026
  lastSeq  Int @default(0) @map("last_seq")

  @@map("support_ticket_counters")
}

// ─── Artículos del blog (contenido público de marketing / educación) ────
// Contenido editorial del portal. slug es la clave de la URL pública (único).
// category y status son Parameter ('blog_category' / 'blog_status'). author es
// un PlatformAdmin (equipo Creditia). Los endpoints públicos filtran status =
// 'published'; draft/archived solo se ven desde el panel admin. El "borrado" es
// suave: se pasa el status a 'archived' (no se elimina la fila).

model BlogPost {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique @db.VarChar(255) // clave de la URL pública
  title           String    @db.VarChar(300)
  excerpt         String?   @db.VarChar(500)
  content         String    @db.Text // HTML del artículo
  coverImageUrl   String?   @map("cover_image_url") @db.VarChar(500)

  categoryId      Int       @map("category_id") // Parameter 'blog_category'
  authorId        String    @map("author_id") @db.Uuid // PlatformAdmin (autor)

  readingMinutes  Int?      @map("reading_minutes")
  tags            String[]  @default([]) // array Postgres text[]

  // Fuente/original del artículo (cuando se escribe a partir de otro contenido).
  // URL externa para mostrar un "Fuente / Ver fuente" al pie. Opcional.
  sourceUrl       String?   @map("source_url") @db.VarChar(500)

  statusId        Int       @map("status_id") // Parameter 'blog_status': draft | published | archived
  publishedAt     DateTime? @map("published_at")

  // SEO. La imagen para Open Graph al compartir usa coverImageUrl (no hay
  // columna og propia: la portada sirve de preview social).
  metaTitle       String?   @map("meta_title") @db.VarChar(300)
  metaDescription String?   @map("meta_description") @db.VarChar(500)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category Parameter     @relation("BlogPostCategory", fields: [categoryId], references: [id])
  status   Parameter     @relation("BlogPostStatus", fields: [statusId], references: [id])
  author   PlatformAdmin @relation("BlogPostAuthor", fields: [authorId], references: [id])

  @@index([statusId, publishedAt]) // listado público (published, orden por publishedAt desc)
  @@index([categoryId])
  @@map("blog_posts")
}

// ─── Facturación electrónica ──────────────────────────────────────────────
//
// El facturador lleva sus propios maestros (terceros, productos, impuestos) y la
// factura solo los REFERENCIA. Las dos tablas de abajo son ese puente, y están
// escritas sin nombrar al proveedor: `provider` + `provider*Id`. Cambiar de
// facturador no toca el esquema, solo el adaptador.

// Catálogo de ítems facturables. Es NUESTRA fuente de verdad de qué se factura;
// el facturador solo guarda una copia enlazada por providerItemId. Las ofertas
// del catálogo (PackOffering) apuntan aquí para saber con qué código facturarse.

model EInvoiceItem {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(50) // 'PACK-CONSULTAS'
  name                String   @db.VarChar(150)
  description         String?  @db.VarChar(500)
  // Unidad de medida DIAN ('94' = unidad). No se vende por peso ni volumen.
  unitMeasurementCode String   @default("94") @map("unit_measurement_code") @db.VarChar(10)
  // Referencial: el precio que factura sale CONGELADO de la venta, no de aquí.
  priceSell           Float?   @map("price_sell")
  // Tarifa esperada del impuesto. Se contrasta con la congelada en la venta
  // antes de emitir: si no casan, la factura saldría por otro valor.
  taxRate             Decimal? @map("tax_rate") @db.Decimal(5, 2)
  isActive            Boolean  @default(true) @map("is_active")

  // Enlace al facturador.
  provider         String    @default("aliaddo") @db.VarChar(50)
  providerItemId   String?   @map("provider_item_id") @db.VarChar(100)
  providerItemCode String?   @map("provider_item_code") @db.VarChar(50)
  // Impuestos del ítem tal como los tiene el facturador: [{ref,name,rate,…}].
  providerTaxIds   Json?     @map("provider_tax_ids") @db.JsonB
  // Categoría y unidad de medida del facturador. Se guardan porque su edición
  // REEMPLAZA el producto: no mandarlas lo dejaría sin ellas.
  providerCategoryRef      String? @map("provider_category_ref") @db.VarChar(100)
  providerMeasuringUnitRef String? @map("provider_measuring_unit_ref") @db.VarChar(100)
  providerSyncedAt DateTime? @map("provider_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  packOfferings PackOffering[]

  @@unique([provider, providerItemId])
  @@map("einvoice_items")
}

// Vínculo empresa ↔ tercero del facturador. Evita rebuscar en cada compra y deja
// constancia de QUIÉN lo vinculó. Guarda la identificación con la que se resolvió:
// si la empresa cambia su documento, el vínculo deja de ser válido.

model EInvoiceContactRef {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @default("aliaddo") @db.VarChar(50)
  companyId         String   @map("company_id") @db.Uuid
  providerContactId String   @map("provider_contact_id") @db.VarChar(100)
  identification    String   @db.VarChar(50)
  displayName       String?  @map("display_name") @db.VarChar(255)
  linkedBy          String?  @map("linked_by") @db.Uuid
  linkedAt          DateTime @default(now()) @map("linked_at")

  company Company        @relation(fields: [companyId], references: [id])
  admin   PlatformAdmin? @relation("EInvoiceContactLinkedBy", fields: [linkedBy], references: [id])

  @@unique([provider, companyId])
  @@map("einvoice_contact_refs")
}

// LEGADO. Con la API contable la resolución y el consecutivo los lleva el
// facturador: nada escribe ya esta tabla. Se conserva porque un documento fiscal
// tiene que poder mostrar bajo qué autorización se expidió, y porque volver a una
// API donde la numeración sea nuestra la necesitaría intacta.

model EInvoiceResolution {
  id            String @id @default(uuid()) @db.Uuid
  // Ambiente en el que aplica: una resolución de producción no sirve en pruebas.
  environment   String @db.VarChar(20) // test | habilitation | production
  // Clave técnica que entrega la DIAN junto con la resolución.
  key           String @db.VarChar(200)
  prefix        String @db.VarChar(10)
  // Número de la RESOLUCIÓN (no del documento). Excede int4.
  number        BigInt
  rangeInitial  Int    @map("range_initial")
  rangeFinal    Int    @map("range_final")
  // Siguiente consecutivo a usar. Arranca en rangeInitial y solo sube.
  nextConsecutive Int  @map("next_consecutive")

  validFrom DateTime @map("valid_from") @db.Date
  validUntil DateTime @map("valid_until") @db.Date

  // Una sola vigente por ambiente. Retirarla (false) no borra el histórico.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices ElectronicInvoice[]

  @@index([environment, isActive])
  @@map("einvoice_resolutions")
}

// Un documento fiscal emitido (o intentado). Guarda el snapshot CONGELADO de lo
// facturado: la empresa puede cambiar sus datos después y la factura emitida no.

model ElectronicInvoice {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  analysisPackId String? @map("analysis_pack_id") @db.Uuid

  provider     String @default("aliaddo") @db.VarChar(50)
  environment  String @db.VarChar(20)
  statusId     Int    @map("status_id") // Parameter 'einvoice_status'
  // LEGADO: numeración propia. Con la API contable la pone el facturador y estas
  // tres quedan en null; `number` guarda el consecutivo completo que devuelve.
  resolutionId String? @map("resolution_id") @db.Uuid
  prefix      String?  @db.VarChar(10)
  consecutive Int?
  number      String?  @db.VarChar(50) // 'SETP994121930'
  issueDate   DateTime @map("issue_date") @db.Date
  dueDate     DateTime @map("due_date") @db.Date

  // Maestros del facturador con los que se emitió. Se guardan porque la factura
  // se anula y se reconsulta contra ELLOS, no contra los datos de hoy.
  providerContactId String? @map("provider_contact_id") @db.VarChar(100)
  providerBranchId  String? @map("provider_branch_id") @db.VarChar(100)

  // Snapshot de lo facturado.
  customerSnapshot Json   @map("customer_snapshot") @db.JsonB
  linesSnapshot    Json   @map("lines_snapshot") @db.JsonB
  currencyCode     String @default("COP") @map("currency_code") @db.VarChar(10)
  taxBase          Float  @map("tax_base")
  taxAmount        Float  @map("tax_amount")
  total            Float

  // Resultado ante la DIAN.
  providerDocumentId String? @map("provider_document_id") @db.VarChar(100)
  cufe               String? @db.VarChar(200)
  qrData             String? @map("qr_data")
  pdfUrl             String? @map("pdf_url")
  xmlUrl             String? @map("xml_url")
  statusReasons      Json?   @map("status_reasons") @db.JsonB
  // Estado CRUDO del facturador ('Vigente/Pagada/Invalida', 'Emision', 'Valida').
  // Nuestro statusId es la lectura de dominio; esto es lo que él dice.
  providerStatus     Json?   @map("provider_status") @db.JsonB

  // Operación.
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)
  sentAt      DateTime? @map("sent_at")
  acceptedAt  DateTime? @map("accepted_at")
  rawRequest  Json?     @map("raw_request") @db.JsonB
  rawResponse Json?     @map("raw_response") @db.JsonB

  // Anulación.
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company             @relation(fields: [companyId], references: [id])
  analysisPack AnalysisPack?       @relation(fields: [analysisPackId], references: [id])
  status       Parameter           @relation("ElectronicInvoiceStatus", fields: [statusId], references: [id])
  resolution   EInvoiceResolution? @relation(fields: [resolutionId], references: [id])
  voidedByAdmin PlatformAdmin?     @relation("ElectronicInvoiceVoidedBy", fields: [voidedBy], references: [id])

  @@index([statusId, createdAt]) // cola de pendientes/rechazadas
  @@index([companyId, createdAt])
  @@map("electronic_invoices")
}

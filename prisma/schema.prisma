// ─── Pagaré (Promissory Note) ───────────────────────────────

model PromissoryNote {
  id            Int    @id @default(autoincrement())
  companyId     String @map("company_id") @db.Uuid
  creditStudyId String @map("credit_study_id") @db.Uuid
  customerId    String @map("customer_id") @db.Uuid
  createdBy     String @map("created_by") @db.Uuid
  statusId      Int    @map("status_id")

  // Consecutivo por empresa: es el "PAGARÉ No. ___" impreso en el documento
  // (el id global sigue siendo el PK técnico de las rutas).
  noteNumber Int @map("note_number")

  // ── Datos económicos del pagaré (snapshot EDITABLE al emitir) ──────────
  // El usuario puede ajustar monto y plazo respecto a la solicitud del estudio:
  // amount ≤ requestedCreditLine (valida el service); termDays es libre.
  amount        Float
  amountInWords String    @map("amount_in_words") @db.VarChar(500)
  termDays      Int?      @map("term_days") // plazo en días acordado al emitir
  dueDate       DateTime? @map("due_date") @db.Date // vencimiento = emisión + termDays

  // ── Snapshot del acreedor al emitir (si la empresa edita sus datos después,
  //    el pagaré ya emitido no cambia) ──
  signCity              String? @map("sign_city") @db.VarChar(150) // ciudad de suscripción (= ciudad de la empresa)
  creditorAddress       String? @map("creditor_address") @db.VarChar(255)
  creditorAccountType   String? @map("creditor_account_type") @db.VarChar(100)
  creditorAccountNumber String? @map("creditor_account_number") @db.VarChar(50)
  creditorBank          String? @map("creditor_bank") @db.VarChar(150)

  // ── Datos del proveedor de firma (agnósticos; provider = quién emitió) ──
  // Nullables porque los pagarés históricos (era DocuSeal) no los tienen.
  provider         String  @default("zapsign") @db.VarChar(50)
  providerDocToken String? @unique @map("provider_doc_token") @db.VarChar(100)
  signerToken      String? @map("signer_token") @db.VarChar(100)
  templateId       String? @map("template_id") @db.VarChar(100)

  signingUrl            String? @map("signing_url") @db.VarChar(500)
  signedDocumentUrl     String? @map("signed_document_url") @db.VarChar(500)
  signedFileStoragePath String? @map("signed_file_storage_path") @db.VarChar(500)

  // ── Auditoría de firma ─────────────────────────────
  sentAt        DateTime? @map("sent_at")
  signedAt      DateTime? @map("signed_at")
  declinedAt    DateTime? @map("declined_at")
  refusedReason String?   @map("refused_reason") @db.VarChar(1000) // motivo del deudor al rechazar en el proveedor

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company     @relation(fields: [companyId], references: [id])
  creditStudy   CreditStudy @relation(fields: [creditStudyId], references: [id])
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        Parameter   @relation("PromissoryNoteStatus", fields: [statusId], references: [id])
  createdByUser Profile     @relation("PromissoryNoteCreatedBy", fields: [createdBy], references: [id])

  @@unique([companyId, noteNumber]) // consecutivo único por empresa
  @@index([companyId])
  @@index([creditStudyId])
  @@index([customerId])
  @@map("promissory_notes")
}

// ─── Autorización del titular consultado ────────────────────
//
// Consentimiento que firma el TITULAR CONSULTADO (persona/empresa a evaluar)
// para que una EMPRESA lo consulte en centrales de riesgo.
//
// Se llavea por la IDENTIDAD (companyId + identificationNumber), la MISMA llave
// natural que Customer, NO por customerId: el Customer nace de la consulta al
// bureau, que a su vez requiere esta firma (huevo-y-gallina). La autorización es
// aguas arriba (existe antes del Customer) y guarda el snapshot de identidad que
// necesita la plantilla; customerId se rellena (backfill) tras la 1ª consulta.
//
// El gate del bureau se DERIVA de signedAt (no revocado).
model CustomerAuthorization {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  // Tipo de finalidad. 'core' = documento único (tratamiento + habeas data +
  // custodia). 'disclosure' = divulgación a terceros (facultativa, 2ª firma; se
  // implementa después). Parameter type 'customer_authorization_type'.
  typeId Int @map("type_id")

  // ── Identidad del titular = misma llave natural que Customer ──
  // Snapshot capturado ANTES de que exista el Customer (variables {{TITULAR_*}}).
  identificationTypeId Int     @map("identification_type_id")
  identificationNumber String  @map("identification_number") @db.VarChar(50)
  titularName          String  @map("titular_name") @db.VarChar(255) // = razón social/apellido
  titularEmail         String  @map("titular_email") @db.VarChar(255) // = firmante Zapsign

  // ── Enlace opcional al Customer (backfill tras la 1ª consulta exitosa) ──
  customerId String? @map("customer_id") @db.Uuid

  // ── Estado ──
  statusId Int @map("status_id") // Parameter 'customer_authorization_status'

  // ── Datos del proveedor de firma (agnósticos; provider = quién emitió) ──
  templateId            String  @map("template_id") @db.VarChar(100)
  provider              String  @default("zapsign") @db.VarChar(50)
  providerDocToken      String  @unique @map("provider_doc_token") @db.VarChar(100)
  signerToken           String? @map("signer_token") @db.VarChar(100)
  signUrl               String? @map("sign_url") @db.VarChar(500)
  signedDocumentUrl     String? @map("signed_document_url") @db.VarChar(500)
  signedFileStoragePath String? @map("signed_file_storage_path") @db.VarChar(500)

  // ── Auditoría de firma ──
  sentAt        DateTime? @map("sent_at")
  signedAt      DateTime? @map("signed_at") // ← gate del bureau
  refusedAt     DateTime? @map("refused_at")
  refusedReason String?   @map("refused_reason") @db.VarChar(1000)

  // ── Revocatoria (no borra la firma, la desactiva; el PDF sigue siendo prueba) ──
  revokedAt DateTime? @map("revoked_at")
  revokedBy String?   @map("revoked_by") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company   @relation(fields: [companyId], references: [id])
  customer           Customer? @relation(fields: [customerId], references: [id])
  type               Parameter @relation("CustomerAuthorizationType", fields: [typeId], references: [id])
  status             Parameter @relation("CustomerAuthorizationStatus", fields: [statusId], references: [id])
  identificationType Parameter @relation("CustomerAuthorizationIdentType", fields: [identificationTypeId], references: [id])
  revokedByUser      Profile?  @relation("CustomerAuthorizationRevokedBy", fields: [revokedBy], references: [id])
  createdByUser      Profile   @relation("CustomerAuthorizationCreatedBy", fields: [createdBy], references: [id])

  // Una autorización por titular/empresa/finalidad. Cuando entre 'disclosure',
  // convive con la 'core' del mismo titular sin chocar.
  @@unique([companyId, identificationNumber, typeId])
  @@index([statusId])
  @@index([customerId])
  @@map("customer_authorizations")
}

// ─── Notificaciones in-app ──────────────────────────────────

